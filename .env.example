# Copy this file to `.env` and edit the values you need.
# Every variable is optional; the defaults below match `config.js`.

# --- Server ---
# Port for the web UI and API.
PORT=3000
# Bind address. Use 127.0.0.1 to restrict access to this machine only.
HOST=0.0.0.0
# auto: prefer local Ollama, fall back to cloud.
# local: only local Ollama. cloud: only the Ollama Cloud API.
MODE=auto
# Set to 1 only when the bridge runs behind a trusted reverse proxy, so the
# real client IP is used for login rate limiting.
TRUST_PROXY=0

# --- Access and encryption ---
# When set, the UI requires this password and chat history is encrypted at
# rest with AES-256-GCM. LEAVE EMPTY to disable both (LAN-only use).
APP_PASSWORD=
# Required for MODE=cloud (https://ollama.com/settings/keys).
OLLAMA_API_KEY=

# --- Ollama endpoints ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CLOUD_URL=https://ollama.com/api

# --- Timeouts ---
# Upstream chat request timeout (ms).
REQUEST_TIMEOUT_MS=120000
# Model/health probe timeout (ms).
DETECT_TIMEOUT_MS=3000
# How often auto mode retries detection (ms).
OLLAMA_HEALTH_INTERVAL_MS=30000

# --- Limits ---
MAX_BODY_SIZE=2mb
# Failed login attempts allowed per window before HTTP 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=60000

# --- Storage ---
# SQLite database file. The directory is created automatically.
# Also useful in tests to isolate state.
DB_PATH=data/chats.db
# Cached model list, refreshed from Ollama.
MODELS_CACHE=models_cache.json
